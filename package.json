{
    "name": "reading-log",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "WRANGLER_LOG_PATH=.wrangler/logs vite",
        "build": "WRANGLER_LOG_PATH=.wrangler/logs tsc -b && WRANGLER_LOG_PATH=.wrangler/logs vite build",
        "deploy": "WRANGLER_LOG_PATH=.wrangler/logs vite build && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy"
    },
    "dependencies": {
        "@xyflow/react": "^12.11.0",
        "dagre": "^0.8.5",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.9.6",
        "@cloudflare/workers-types": "^4.20260617.0",
        "@tailwindcss/vite": "^4.3.1",
        "@types/dagre": "^0.7.54",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "tailwindcss": "^4.3.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.7",
        "wrangler": "^4.20.0"
    }
}
